{
    "manifest_version": 3,

    "name": "__MSG_appName__",
    "short_name": "__MSG_appShortName__",
    "version": "1.0.2",
    "description": "__MSG_appDesc__",

    "default_locale": "en",

    "minimum_chrome_version": "128",

    "browser_specific_settings": {
        "gecko": {
            "id": "@slipstreamlive-tail4126",
            "data_collection_permissions": { "required": ["none"] },
            "strict_min_version": "140.0"
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    },

    "icons": {
        "16": "icons/16.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },

    "content_scripts": [
        {
            "js": [
                "shared/schema.js",
                "common.js",
                "content.js"
            ],
            "run_at": "document_start",
            "matches": [
                "https://www.youtube.com/*",
                "https://m.youtube.com/*",
                "https://www.youtube-nocookie.com/*",
                "https://www.twitch.tv/*",
                "https://player.twitch.tv/*",
                "https://clips.twitch.tv/*",
                "https://twitcasting.tv/*",
                "https://*.twitcasting.tv/*"
            ],
            "exclude_matches": [
                "https://www.youtube.com/live_chat*",
                "https://m.youtube.com/live_chat*",
                "https://www.twitch.tv/popout/*/chat*",
                "https://www.twitch.tv/embed/*/chat*"
            ],
            "all_frames": true
        },
        {
            "js": [
                "shared/util.js",
                "adapters/youtube.js",
                "adapters/twitch.js",
                "adapters/twitcasting.js",
                "inject.js"
            ],
            "world": "MAIN",
            "run_at": "document_start",
            "matches": [
                "https://www.youtube.com/*",
                "https://m.youtube.com/*",
                "https://www.youtube-nocookie.com/*",
                "https://www.twitch.tv/*",
                "https://player.twitch.tv/*",
                "https://clips.twitch.tv/*",
                "https://twitcasting.tv/*",
                "https://*.twitcasting.tv/*"
            ],
            "exclude_matches": [
                "https://www.youtube.com/live_chat*",
                "https://m.youtube.com/live_chat*",
                "https://www.twitch.tv/popout/*/chat*",
                "https://www.twitch.tv/embed/*/chat*"
            ],
            "all_frames": true
        }
    ],

    "action": {
        "default_popup": "popup.html"
    },

    "options_ui": {
        "page": "popup.html",
        "open_in_tab": true
    },

    "permissions": [
        "storage",
        "activeTab"
    ]
}